# Settings for the local Docker stack (docker-compose.yml). Copy to .env (never commit .env).
# API keys go in backend/.env (read by the stack when it exists).
# Production uses docker-compose.prod.yml + .env.prod (see .env.prod.example, DEPLOYMENT.md).

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Host ports (defaults avoid the dev servers on 8000/5173 and a local database on 5432)
WEB_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380

# PostgreSQL inside the stack
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs

# Celery worker processes (1 keeps memory use low on a laptop)
WORKER_CONCURRENCY=1
