# Docker Compose settings. Copy to .env (never commit .env).

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Host ports
WEB_PORT=80
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
GOTENBERG_PORT=3000

# PostgreSQL (used from Phase 3)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs

# MinIO object storage (used from Phase 6)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
