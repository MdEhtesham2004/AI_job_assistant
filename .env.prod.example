# Production settings for docker-compose.prod.yml. Copy to .env.prod — never commit it.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_VERSION=0.1.0
WEB_PORT=80
# Your domain once you have one (HTTPS, Gmail redirect, CORS).
SERVER_NAME=jobs.example.com
PUBLIC_URL=https://jobs.example.com

# --- Database (internal) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=<long-random-password>
POSTGRES_DB=jobs

# --- API ---
SECRET_KEY=<64-random-characters>
CORS_ORIGINS=["https://jobs.example.com"]
API_WORKERS=2
WORKER_CONCURRENCY=2
LOG_LEVEL=INFO
# First admin, once after the first start (asks for the password):
#   docker compose -f docker-compose.prod.yml --env-file .env.prod exec api python -m app.cli create-admin --email you@example.com

# --- AI (OpenRouter) ---
AI_API_KEY=<openrouter-key>
AI_MODEL_DEFAULT=openai/gpt-oss-120b

# --- Job search (JSearch on RapidAPI) — use a NEW key (the legacy n8n key was exposed) ---
JSEARCH_API_KEY=<rapidapi-key>

# --- Gmail (Google Cloud OAuth client, type Web application) ---
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=https://jobs.example.com/api/v1/integrations/gmail/callback
FRONTEND_URL=https://jobs.example.com
# Fernet key — keep it forever (changing it disconnects every Gmail account):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<fernet-key>

# --- LinkedIn hiring posts (Apify) ---
APIFY_TOKEN=<apify-token>

# --- Search API cost control (defaults shown; per-user limits: Settings › Platform) ---
# JSEARCH_CACHE_HOURS=12
# APIFY_CACHE_HOURS=24
# APIFY_MAX_CHARGE_USD=0
# JSEARCH_COST_PER_REQUEST_USD=0
# APIFY_COST_PER_1000_POSTS_USD=0

# --- Monitoring (optional: errors go to Sentry only when set) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Backups ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- AI mock interview (Phase 15): OpenAI Realtime, speech-to-speech ---
# A real OpenAI key (platform.openai.com, billing on). Not OPENAI_API_KEY: that name is
# read as the OpenRouter key.
OPENAI_REALTIME_API_KEY=
# REALTIME_MODEL=gpt-realtime-mini
# REALTIME_VOICE=marin
# REALTIME_COST_PER_MINUTE_USD=0.10
# Gemini Live (Google AI Studio key) — used automatically when set (INTERVIEW_VOICE_PROVIDER=auto)
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Aoede
# GEMINI_COST_PER_MINUTE_USD=0.04
# INTERVIEW_VOICE_PROVIDER=auto   # auto | gemini | openai
