# Copy to .env.local for local development. Never commit real .env files.

# Base path of the API as seen by the browser (proxied by Vite in dev, Nginx in Docker).
# Frontend on another site (e.g. Vercel) → the full API URL, set in Vercel's Environment
# Variables (it is read at build time, so redeploy after changing it):
#   VITE_API_BASE_URL=https://<your-tunnel>.ngrok-free.dev/api/v1
# The backend then needs CORS_ORIGINS with the site, COOKIE_SAMESITE=none and
# FRONTEND_URL / PUBLIC_API_URL pointing at the site / tunnel.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests (dev only)
VITE_PROXY_TARGET=http://localhost:8000
