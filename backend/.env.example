# Copy to .env for running the backend locally without Docker.
# Never commit .env.

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# false = readable console logs, true = JSON lines
LOG_JSON=false
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL 16 (async driver). Real password only in .env.
DATABASE_URL=postgresql+asyncpg://app:<password>@localhost:5432/jobs
# Separate database for automated tests — wiped by the test suite.
TEST_DATABASE_URL=postgresql+asyncpg://app:<password>@localhost:5432/jobs_test

# Signs access + password-reset tokens. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<at-least-32-random-characters>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30

# --- Phase 6: background work & services ---
REDIS_URL=redis://localhost:6379/0
# false = tasks are recorded but not sent to a worker
CELERY_ENABLED=true
GOTENBERG_URL=http://localhost:3000
# local = files in backend/storage/ (git-ignored); s3 arrives in Phase 14
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage

# Any OpenAI-compatible API. OpenRouter key also accepted as OPENROUTER_API_KEY / OPENAI_API_KEY.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=<your-openrouter-key>
AI_MODEL_DEFAULT=openai/gpt-oss-120b
# Optional tuning (defaults shown)
# AI_TIMEOUT_SECONDS=120
# AI_MAX_OUTPUT_TOKENS=8000
# AI_REASONING_EFFORT=low
# AI_PROVIDER_SORT=throughput

# --- Job search (Phase 8) — RapidAPI key for JSearch (also read from RAPIDAPI_KEY) ---
JSEARCH_API_KEY=<your-rapidapi-key>
# JSEARCH_SEARCH_PATH=/search-v2
# JSEARCH_COUNTRY=in
# JSEARCH_NUM_PAGES=1
# JSEARCH_DATE_POSTED=week
# MAX_ACTIVE_SAVED_SEARCHES=5
# SAVED_SEARCH_MIN_INTERVAL_MINUTES=60

# --- Resumes (Phase 7) ---
# RESUME_MAX_BYTES=5242880
# RESUME_AI_MAX_CHARS=20000

# --- Gmail + outreach (Phase 12) ---
# Google Cloud → APIs & Services: enable the Gmail API, OAuth client type "Web application",
# redirect URI = GOOGLE_REDIRECT_URI below; add yourself as a test user on the consent screen.
GOOGLE_CLIENT_ID=<your-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-oauth-client-secret>
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
# FRONTEND_URL=http://localhost:5173
# Encrypts Gmail tokens in the database. Generate once and keep it (changing it = reconnect):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<fernet-key>
# LinkedIn hiring posts (Apify actor harvestapi/linkedin-post-search)
APIFY_TOKEN=<your-apify-token>
# APIFY_MAX_POSTS=50
# SEND_WINDOW_START_HOUR=9
# SEND_JITTER_SECONDS=30
